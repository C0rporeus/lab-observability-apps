# PostgreSQL Database Configuration (valores por defecto para desarrollo local)
POSTGRES_DB=observability
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# Database Connection (para microservicios)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=observability

# Weather API Configuration (REQUERIDO - obtener tu API key en https://openweathermap.org/api)
WEATHER_API_KEY=YOUR_WEATHER_API_KEY_HERE

# OpenTelemetry Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

